{
  "expo": {
    "name": "My addresses",
    "slug": "addressbook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "addressbook",
    "userInterfaceStyle": "light",
    "ios": {
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.suraj.addressbook"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-rideshare-queries",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F5",
          "image": "./assets/images/app-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo to help recognize a saved place.",
          "cameraPermission": "Allow camera access to take a photo of a place.",
          "microphonePermission": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "ne",
            "en",
            "hi",
            "es",
            "vi",
            "km",
            "ur",
            "bn",
            "ta",
            "si",
            "pa"
          ],
          "supportsRTL": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#F5F5F5",
    "locales": {
      "ne": "./assets/locales/ne.json",
      "en": "./assets/locales/en.json",
      "hi": "./assets/locales/hi.json",
      "es": "./assets/locales/es.json",
      "vi": "./assets/locales/vi.json",
      "km": "./assets/locales/km.json",
      "ur": "./assets/locales/ur.json",
      "bn": "./assets/locales/bn.json",
      "ta": "./assets/locales/ta.json",
      "si": "./assets/locales/si.json",
      "pa": "./assets/locales/pa.json"
    }
  }
}
