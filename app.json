{
  "expo": {
    "name": "My addresses",
    "slug": "addressbook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "addressbook",
    "userInterfaceStyle": "light",
    "ios": {
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.suraj.addressbook"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-rideshare-queries",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F5",
          "image": "./assets/images/app-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo to help recognize a saved place.",
          "cameraPermission": "Allow camera access to take a photo of a place.",
          "microphonePermission": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "ne",
            "en",
            "ru",
            "hi",
            "ja",
            "it",
            "fr",
            "es"
          ],
          "supportsRTL": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#F5F5F5",
    "locales": {
      "ne": "./assets/locales/ne.json",
      "en": "./assets/locales/en.json",
      "ru": "./assets/locales/ru.json",
      "hi": "./assets/locales/hi.json",
      "ja": "./assets/locales/ja.json",
      "it": "./assets/locales/it.json",
      "fr": "./assets/locales/fr.json",
      "es": "./assets/locales/es.json"
    }
  }
}
